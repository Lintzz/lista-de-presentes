NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Mercado Livre - API oficial (opcional, mas necessaria em producao).
# O ML bloqueia scraping vindo de IPs de datacenter (Vercel), entao o
# preenchimento automatico de links do ML usa a API oficial como fallback.
# Crie um app gratuito em https://developers.mercadolivre.com.br (Minhas aplicacoes).
ML_CLIENT_ID=your_ml_client_id_here
ML_CLIENT_SECRET=your_ml_client_secret_here
# Opcionais: use apenas se o grant client_credentials nao funcionar no seu app.
# ML_REFRESH_TOKEN=
# ML_ACCESS_TOKEN=
